<Project Sdk="Microsoft.NET.Sdk">

  <!-- EgoAnchor_Tools3: 离线实时升采样仿真。用真实录制的 ~5fps 观测 pose 驱动多种
       实时预测算法, 每帧 (~60fps) 输出最新外推 pose, 并用 ScottPlot 画对比曲线。
       完全自包含: 不依赖 Unity DLL, 自带 Vec3/Quat 数学。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EgoAnchor.Tools3</RootNamespace>
    <AssemblyName>AnchorUpsampleSim3</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- 纯控制台生成 PNG, 不依赖 WinForms/WPF/Avalonia -->
    <PackageReference Include="ScottPlot" Version="5.0.55" />
  </ItemGroup>

</Project>
