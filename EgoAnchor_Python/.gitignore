# Python root environments and caches
/.pixi/
/.venv/
/.mypy_cache/
/__pycache__/
/build/
/dist/
/wheels/
/logs/
/*.egg-info/
/*.py[cod]

# First-party Python bytecode and package metadata
/src/**/__pycache__/
/src/**/*.py[cod]
/src/*.egg-info/
/eval/**/__pycache__/
/eval/**/*.py[cod]
/tools/**/__pycache__/
/tools/**/*.py[cod]
/samples/**/__pycache__/
/samples/**/*.py[cod]
/Calibration/**/__pycache__/
/Calibration/**/*.py[cod]

# EgoAnchor Python root model artifacts
/weights/
/*.pt
/*.pth
/*.onnx
/*.engine
/*.plan

# Runtime calibration cache
/Calibration/cache/camera_info_latest.json
/Calibration/cache/camera_info_*.json

# Runtime and evaluation outputs
/data/debug/**
!/data/debug/detection_color.png
!/data/debug/detection_depth.png
!/data/debug/detection_mask.png
/data/eval/
/data/online/*/output/
/data/runtime_logs/

# Logs pulled back from remote GPU boxes; keep a possible placeholder trackable.
/data/runtime_logs_remote/*
!/data/runtime_logs_remote/.gitkeep

# Mutagen project lock file
/mutagen.yml.lock
