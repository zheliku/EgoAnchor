<Project Sdk="Microsoft.NET.Sdk">

  <!-- EgoAnchor_Tools2:离线 anchor policy 仿真程序,用真实录制数据驱动多种预测算法并输出对比曲线。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- 与 EgoAnchor_Tools 保持一致的 C# 语言版本与可空设置 -->
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <!-- 关闭不相关的告警 -->
    <NoWarn>$(NoWarn);CS0649;CS0169</NoWarn>
    <!-- 默认命名空间,避免与 Unity 侧 EgoAnchor.Policy 冲突 -->
    <RootNamespace>EgoAnchor.Tools2</RootNamespace>
    <AssemblyName>AnchorPolicySim</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- ScottPlot 核心包,纯控制台生成 PNG,不依赖 WinForms/WPF/Avalonia -->
    <PackageReference Include="ScottPlot" Version="5.0.55" />
  </ItemGroup>

</Project>
