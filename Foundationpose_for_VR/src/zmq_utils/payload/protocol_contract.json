{
  "version": 1,
  "transport": {
    "pattern": "ZMQ PUB/SUB",
    "multipart": ["topic_utf8", "payload_msgpack"],
    "payload_encoding": "MessagePack",
    "latest_drain": "per_topic"
  },
  "endpoints": {
    "unity_to_python": {
      "topic_owner": "Unity PayloadSender",
      "receiver": "Python QuestReceiver",
      "default_port": 5557,
      "topics": ["quest_stereo", "quest_camera_info"]
    },
    "python_to_unity": {
      "topic_owner": "Python pose_server",
      "receiver": "Unity PayloadReceiver",
      "default_port": 5556,
      "topics": ["pose"]
    }
  },
  "topics": {
    "quest_stereo": {
      "direction": "unity_to_python",
      "message": "QuestStereoMsg"
    },
    "quest_camera_info": {
      "direction": "unity_to_python",
      "message": "QuestCameraInfoMsg"
    },
    "pose": {
      "direction": "python_to_unity",
      "message": "PoseMsg"
    }
  },
  "messages": {
    "QuestStereoMsg": {
      "description": "Quest stereo JPEG frame.",
      "required": [
        "left_image_jpeg",
        "right_image_jpeg",
        "frame_id",
        "sender_mono_ms",
        "unity_frame"
      ],
      "fields": {
        "left_image_jpeg": "bytes",
        "right_image_jpeg": "bytes",
        "frame_id": "int",
        "sender_mono_ms": "float_ms",
        "unity_frame": "int"
      }
    },
    "QuestCameraInfoMsg": {
      "description": "Quest stereo camera intrinsics and static camera metadata.",
      "required": [
        "is_supported",
        "left_fx",
        "left_fy",
        "left_cx",
        "left_cy",
        "right_fx",
        "right_fy",
        "right_cx",
        "right_cy",
        "left_distortion",
        "right_distortion",
        "baseline_m",
        "sensor_width",
        "sensor_height",
        "active_left",
        "active_top",
        "active_right",
        "active_bottom",
        "left_requested_width",
        "left_requested_height",
        "right_requested_width",
        "right_requested_height",
        "current_width",
        "current_height",
        "max_framerate",
        "left_lens_offset_px",
        "left_lens_offset_py",
        "left_lens_offset_pz",
        "left_lens_offset_qx",
        "left_lens_offset_qy",
        "left_lens_offset_qz",
        "left_lens_offset_qw",
        "right_lens_offset_px",
        "right_lens_offset_py",
        "right_lens_offset_pz",
        "right_lens_offset_qx",
        "right_lens_offset_qy",
        "right_lens_offset_qz",
        "right_lens_offset_qw",
        "sender_mono_ms"
      ],
      "fields": {
        "is_supported": "bool",
        "left_fx": "float",
        "left_fy": "float",
        "left_cx": "float",
        "left_cy": "float",
        "right_fx": "float",
        "right_fy": "float",
        "right_cx": "float",
        "right_cy": "float",
        "left_distortion": "float_array",
        "right_distortion": "float_array",
        "baseline_m": "float_m",
        "sensor_width": "int",
        "sensor_height": "int",
        "active_left": "int",
        "active_top": "int",
        "active_right": "int",
        "active_bottom": "int",
        "left_requested_width": "int",
        "left_requested_height": "int",
        "right_requested_width": "int",
        "right_requested_height": "int",
        "current_width": "int",
        "current_height": "int",
        "max_framerate": "int",
        "left_lens_offset_px": "float_m",
        "left_lens_offset_py": "float_m",
        "left_lens_offset_pz": "float_m",
        "left_lens_offset_qx": "float",
        "left_lens_offset_qy": "float",
        "left_lens_offset_qz": "float",
        "left_lens_offset_qw": "float",
        "right_lens_offset_px": "float_m",
        "right_lens_offset_py": "float_m",
        "right_lens_offset_pz": "float_m",
        "right_lens_offset_qx": "float",
        "right_lens_offset_qy": "float",
        "right_lens_offset_qz": "float",
        "right_lens_offset_qw": "float",
        "sender_mono_ms": "float_ms"
      }
    },
    "PoseMsg": {
      "description": "Pose result and debug state. pose_matrix_flat is row-major 4x4 OpenCV camera pose when has_pose is true.",
      "coordinate_frame": {
        "python_output": "OpenCV camera coordinates: +x right, +y down, +z forward",
        "unity_decoder_default": "PoseDecoder converts OpenCV camera coordinates to Unity: +x right, +y up, +z forward"
      },
      "required": [
        "timestamp_ms",
        "frame_id",
        "stage",
        "phase",
        "det_count",
        "depth_valid_ratio",
        "fps",
        "has_pose",
        "pose_matrix_flat",
        "yolo_ms",
        "depth_ms",
        "cutie_ms",
        "pose_ms"
      ],
      "fields": {
        "timestamp_ms": "float_ms",
        "frame_id": "int",
        "stage": "int",
        "phase": "string",
        "det_count": "int",
        "depth_valid_ratio": "float",
        "fps": "float",
        "has_pose": "bool",
        "pose_matrix_flat": "nullable_float_array_16",
        "yolo_ms": "float_ms",
        "depth_ms": "float_ms",
        "cutie_ms": "float_ms",
        "pose_ms": "float_ms"
      }
    }
  }
}
