{
    "files.exclude": {
        "**/*.meta": true,
        "**/build/": true,
        "**/Build/": true,
        "**/Library/": true,
        "**/library/": true,
        "**/obj/": true,
        "**/Obj/": true,
        "**/Logs/": true,
        "**/logs/": true,
        "**/UserSettings/": true,
        "**/temp/": true,
        "**/Temp/": true
    },
    "files.associations": {
        "*.asset": "yaml",
        "*.meta": "yaml",
        "*.prefab": "yaml",
        "*.unity": "yaml"
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.sln": "*.csproj"
    },
    "dotnet.defaultSolution": "EgoAnchor_Unity/EgoAnchor_Unity.slnx",
    "python-envs.defaultEnvManager": "ms-python.python:system",
    "python-envs.pythonProjects": [
        {
            "path": "EgoAnchor_Python",
            "envManager": "ms-python.python:system",
            "packageManager": "ms-python.python:pip"
        }
    ]
}
